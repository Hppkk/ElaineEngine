{
  "version": "2.0.0",
  "renderQueue": "opaque",
  "textures": {},
  "shaderpass": [
    {
      "name": "GBuffer",
      "shaders": { "vs": "DeferredGBuffer.vs", "ps": "DeferredGBuffer.ps" },
      "renderQueue": "opaque",
      "depth": { "test": true, "write": true, "func": "less_equal" },
      "raster": { "cull": "back", "frontFace": "ccw", "fill": "solid" },
      "blend": { "enable": false }
    }
  ],
  "parameters": {
    "BaseColorFactor": { "type": "color", "default": [1.0, 1.0, 1.0, 1.0] },
    "EmissiveFactor": { "type": "color", "default": [0.0, 0.0, 0.0, 0.0] },
    "Roughness": { "type": "scalar", "default": 0.5, "min": 0.0, "max": 1.0 },
    "Metallic": { "type": "scalar", "default": 0.0, "min": 0.0, "max": 1.0 }
  }
}
