{
  "version": "2.0.0",

  "macros": [ "USE_SKYBOX" ],

  "renderQueue": "background",

  "textures": {
    "CubeMap": "texture/sky/sky.tex"
  },

  "shaderpass": [
    {
      "name": "Sky",

      "shaders": {
        "vs": "sky.vs",
        "ps": "sky.ps"
      },

      "macros": {
        "PASS_SKY": 1
      },

      "depth": {
        "test": true,
        "write": true,
        "func": "less_equal"
      },

      "raster": {
        "cull": "front",
        "fill": "solid",
        "frontFace": "cw"
      },

      "blend": {
        "enable": false
      }
    }
  ],
  "parameters": {
    "Exposure": { "type": "scalar", "default": 1.0, "min": 0.0, "max": 8.0 }
  }
}
